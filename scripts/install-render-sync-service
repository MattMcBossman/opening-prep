#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/mainline"

mkdir -p "$unit_dir" "$config_dir"
install -m 0644 "$repo_root/deploy/systemd/mainline-render-sync.service" "$unit_dir/"
install -m 0644 "$repo_root/deploy/systemd/mainline-render-sync.timer" "$unit_dir/"

if [[ ! -f "$config_dir/render-sync.env" ]]; then
    install -m 0600 /dev/null "$config_dir/render-sync.env"
    echo 'MAINLINE_RENDER_DATABASE_URL=replace-with-the-Render-external-database-URL' >> "$config_dir/render-sync.env"
    echo "Created $config_dir/render-sync.env; add the Render external database URL before enabling the timer."
fi

systemctl --user daemon-reload
echo "Validate first: cd $repo_root/backend && uv run manage.py sync_render_to_tailscale --dry-run"
echo "Then enable: systemctl --user enable --now mainline-render-sync.timer"
