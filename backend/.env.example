# Copy to backend/.env and adjust. Values here are the local-development defaults.

DJANGO_SECRET_KEY=dev-only-insecure-secret-key
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to send CSRF-protected requests. In dev the SPA is same-origin
# via the Vite proxy, but the dev server's own origin still needs to be trusted.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Local PostgreSQL (see backend/README.md for the role/database setup).
DATABASE_URL=postgres://opening_prep:devpassword@localhost:5432/opening_prep

# Where to send the browser after a completed OAuth round trip.
FRONTEND_URL=http://localhost:5173

# Mainline sign-in. Create a Web OAuth client in Google Cloud and register the
# callback below as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback

# Optional. `../scripts/remote-dev` sets this automatically for its child
# processes; normally do not persist it here. When set, Django adds the exact
# Tailscale origin to ALLOWED_HOSTS/CSRF and uses it for OAuth redirects. HTTP is
# accepted only with DJANGO_DEBUG=True for private tailnet development.
REMOTE_DEV_ORIGIN=

# Lichess is a public OAuth client: no secret, no scopes. The client id is just
# an identifying string, conventionally the app URL.
LICHESS_HOST=https://lichess.org
CHESS_COM_API_URL=https://api.chess.com/pub
# Chess.com recommends an identifying User-Agent with contact information in production.
CHESS_COM_USER_AGENT=Mainline/0.1 (contact: you@example.com)
LICHESS_EXPLORER_URL=https://explorer.lichess.org/lichess
LICHESS_CLIENT_ID=opening-prep-local
LICHESS_REDIRECT_URI=http://localhost:5173/api/v1/auth/lichess/callback
# Optional server/curator token for the opening candidate generator and
# anonymous explorer proxy fallback. Never pass tokens as CLI arguments.
LICHESS_SERVER_TOKEN=

# Encrypts stored Lichess access tokens at rest. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# How long a cached explorer response stays fresh (seconds). Aggregate stats
# move slowly, so a day is plenty.
EXPLORER_CACHE_TTL_SECONDS=86400
PLAYER_EXPLORER_CACHE_TTL_SECONDS=600
