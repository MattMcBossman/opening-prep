# Copy to backend/.env and adjust. Values here are the local-development defaults.

DJANGO_SECRET_KEY=dev-only-insecure-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to send CSRF-protected requests. In dev the SPA is same-origin
# via the Vite proxy, but the dev server's own origin still needs to be trusted.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Local PostgreSQL (see backend/README.md for the role/database setup).
DATABASE_URL=postgres://opening_prep:devpassword@localhost:5432/opening_prep

# Where to send the browser after a completed OAuth round trip.
FRONTEND_URL=http://localhost:5173

# Lichess is a public OAuth client: no secret, no scopes. The client id is just
# an identifying string, conventionally the app URL.
LICHESS_HOST=https://lichess.org
LICHESS_EXPLORER_URL=https://explorer.lichess.org/lichess
LICHESS_CLIENT_ID=opening-prep-local
LICHESS_REDIRECT_URI=http://localhost:5173/api/v1/auth/lichess/callback

# Encrypts stored Lichess access tokens at rest. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# How long a cached explorer response stays fresh (seconds). Aggregate stats
# move slowly, so a day is plenty.
EXPLORER_CACHE_TTL_SECONDS=86400
